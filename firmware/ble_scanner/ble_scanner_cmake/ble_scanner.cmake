set_property(TARGET slc_ble_scanner PROPERTY CXX_STANDARD 17)
set_property(TARGET slc_ble_scanner PROPERTY CXX_EXTENSIONS OFF)

target_link_options(slc_ble_scanner INTERFACE
    -mcpu=cortex-m33
    -mthumb
    -mfpu=fpv5-sp-d16
    -mfloat-abi=hard
    -T${CMAKE_CURRENT_LIST_DIR}/../autogen/linkerfile.ld
    --specs=nano.specs
    "SHELL:-Xlinker -Map=$<TARGET_FILE_DIR:ble_scanner>/ble_scanner.map"
    "SHELL:-Wl,--wrap=_free_r -Wl,--wrap=_malloc_r -Wl,--wrap=_calloc_r -Wl,--wrap=_realloc_r"
    -fno-lto
    -Wl,--gc-sections
)

# Simplicity Studio metadata removed: ble_scanner.slcp is the source of truth.
